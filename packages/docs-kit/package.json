{
  "name": "@botiverse/docs-kit",
  "version": "0.1.1",
  "description": "Reusable documentation-site kit (VitePress config factory, theme, content conventions, build checks). Extracted from raft-docs; the Hands docs site is the pilot consumer.",
  "type": "module",
  "exports": {
    "./scripts/redirect-rules": "./src/scripts/redirect-rules.mjs",
    "./scripts/i18n-coverage": "./src/scripts/check-i18n-coverage.mjs",
    "./scripts/agent-artifacts": "./src/scripts/generate-agent-artifacts.mjs",
    "./scripts/sitemap-redirects": "./src/scripts/check-sitemap-redirects.mjs",
    "./config": "./src/config.mjs",
    "./content": "./src/content.mjs",
    "./theme": "./src/theme/index.ts",
    "./config/node": "./src/config-node.mjs"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.mjs\""
  },
  "files": [
    "src",
    "!src/**/*.test.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.0",
    "vue": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-docs.git",
    "directory": "packages/docs-kit"
  }
}
