{
  "name": "raft-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Raft public documentation site (VitePress, deployed at docs.raft.build)",
  "scripts": {
    "dev": "vitepress dev --host 0.0.0.0",
    "build": "vitepress build && node packages/docs-kit/src/scripts/generate-agent-artifacts.mjs --root . && node packages/docs-kit/src/scripts/check-sitemap-redirects.mjs --root .",
    "check:agent-artifacts": "node packages/docs-kit/src/scripts/generate-agent-artifacts.mjs --root . --check",
    "check:sitemap-redirects": "node packages/docs-kit/src/scripts/check-sitemap-redirects.mjs --root .",
    "check:redirect-matcher": "node packages/docs-kit/src/scripts/check-sitemap-redirects.mjs --root . --self-test",
    "preview": "vitepress preview --host 0.0.0.0",
    "check:i18n-coverage": "node packages/docs-kit/src/scripts/check-i18n-coverage.mjs --root ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "typescript": "^5.5.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-tabs": "^0.9.0",
    "vue": "^3.5.35"
  },
  "dependencies": {
    "posthog-js": "^1.393.5"
  }
}
